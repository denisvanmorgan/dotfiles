" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins
" Commentary plugin
Plug 'tpope/vim-commentary'
" Change brackets real quick -> https://github.com/tpope/vim-surround
Plug 'tpope/vim-surround'
" Cool stuff with functin arguments
Plug 'vim-scripts/argtextobj.vim'
" Match all {}
Plug 'dbakker/vim-paragraph-motion'
" Nerdtree
Plug 'preservim/nerdtree'
" Function (af/if) and class (ac) text objects, like nvim-treesitter-textobjects
Plug 'kana/vim-textobj-function'
Plug 'vim-textobj-class'

set incsearch
set hlsearch

" Set leader key to space
let mapleader = " "
let maplocalleader = " "

" Enable relative line numbers
set number
set relativenumber

" Disable showing the mode below the statusline
set noshowmode

" Enable smart indenting
set breakindent
set autoindent

" Disable text wrap
set nowrap

" Enable cursor line highlight
set cursorline

" Always keep 10 lines above/below cursor unless at start/end of file
set scrolloff=999

" Set command height to 0
set cmdheight=0

set ignorecase
set smartcase
set showcmd

" Vim handles these in normal/visual, IDE keeps them in insert (completion etc.)
sethandler <C-Space> n-v:vim i:ide
sethandler <F2> n-v:vim i:ide
sethandler <F3> n-v:vim i:ide
sethandler <F4> n-v:vim i:ide

" Neovim default: Y yanks to end of line
nnoremap Y y$

" Buffer navigation
nnoremap <leader>d :bd<CR>

" Clipboard
xnoremap <leader>y "+y
nnoremap <leader>y "+y
xnoremap <leader>p "+p
nnoremap <leader>p "+p

" Incremental selection
nmap <C-Space> <Action>(EditorSelectWord)
xmap <C-Space> <Action>(EditorSelectWord)
xmap <BS> <Action>(EditorUnSelectWord)

" Text objects
omap af <Plug>(textobj-function-am)
xmap af <Plug>(textobj-function-am)
omap if <Plug>(textobj-function-im)
xmap if <Plug>(textobj-function-im)

" Telescope
nmap <leader>ff <Action>(GotoFile)
nmap <leader>fw <Action>(FindInPath)
nmap <leader>b <Action>(RecentFiles)

" Neo-tree
nnoremap <leader>tr :NERDTreeToggle<CR>
nnoremap <leader>e :NERDTreeFind<CR>

" LSP
nmap K <Action>(ShowHoverInfo)
nmap go <Action>(GotoTypeDeclaration)
nmap gr <Action>(ShowUsages)
nmap gO <Action>(FileStructurePopup)
nmap ]d <Action>(GotoNextError)
nmap [d <Action>(GotoPreviousError)
nmap <F2> <Action>(RenameElement)
nmap <F3> <Action>(ReformatCode)
xmap <F3> <Action>(ReformatCode)
nmap <F4> <Action>(ShowIntentionActions)

" Gitsigns
nmap ]c <Action>(VcsShowNextChangeMarker)
nmap [c <Action>(VcsShowPrevChangeMarker)
nmap <leader>gr <Action>(Vcs.RollbackChangedLines)
nmap <leader>gp <Action>(VcsShowCurrentChangeMarker)
nmap <leader>gb <Action>(Annotate)

" -- Map IDE actions to IdeaVim -- https://jb.gg/abva4t
nmap <leader>r <Action>(Run)
nmap <leader>s <Action>(Stop)
nmap \b <Action>(ToggleLineBreakpoint)
nmap ga <Action>(GotoAction)
nmap gi <Action>(GotoImplementation)
nmap gs <Action>(GotoSuperMethod)
nmap gd <Action>(GotoDeclaration)
nmap <leader>sh <Action>(ShowHoverInfo)
nmap <leader>se <Action>(ShowErrorDescription)
nmap <leader>gt <Action>(GotoTest)
nmap <leader>re <Action>(RenameElement)
nmap <leader>rf <Action>(RenameFile)
nmap <leader>fu <Action>(FindUsages)
nmap <leader>su <Action>(ShowUsages)
nmap <leader>h <Action>(PreviousTab)
nmap <leader>j <Action>(NextTab)
nmap <C-z> <Action>(ToggleDistractionFreeMode)
nmap <leader>nc <Action>(PhpNewClass)
